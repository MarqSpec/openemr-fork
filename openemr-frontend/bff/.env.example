# Token handler (BFF) configuration - every setting it reads, parsed and validated once at start-up
# (src/config.ts). A bad or missing value stops the process with a list of every problem, naming the
# variable and the rule, never the value. Synthetic example values only; never commit a real one.
# The service does not read this file itself - export the variables, or let the platform inject them.

# Port and interface to listen on. PORT is the name most platforms inject. Defaults: 8080, 0.0.0.0.
PORT=8080
BFF_HOST=0.0.0.0

# REQUIRED. The SPA's `vite build` output (must contain index.html), relative to the working directory.
BFF_SPA_DIST_DIR=../dist

# REQUIRED. OpenEMR as the token handler reaches it: https, or plain http on localhost only; no
# credentials, query or fragment. May include a webroot path (https://clinic.example.test/openemr).
OPENEMR_BASE_URL=https://openemr.example.test

# OpenEMR site id (the `default` in /apis/default/fhir). Default: default.
OPENEMR_SITE=default

# The origin the browser is sent to for sign-in; CSP form-action allows it. Default: the origin of
# OPENEMR_BASE_URL. Set it when the browser reaches OpenEMR on another host than the token handler does.
# OPENEMR_AUTHORIZE_ORIGIN=https://login.example.test

# /bff/ready's budget for OpenEMR SMART discovery, in ms (1-60000). Default: 5000.
BFF_READY_TIMEOUT_MS=5000

# fatal | error | warn | info | debug | trace | silent. Default: info.
BFF_LOG_LEVEL=info

# The commit the image was built from, reported by /bff/health as `build` (public, not a secret). The image
# reads the BUILD_SHA file in the build context when that file contains a commit id (the staging deploy writes
# it into the upload); otherwise it uses the Dockerfile ARG. Not a Railway service variable.
# Lower-case hex, 7-40 chars; empty or unset = "unknown".
# BUILD_SHA=

# REQUIRED. The origin browsers load this service from (scheme://host[:port], no path or trailing slash).
# The OAuth redirect URIs are built on it - <origin>/bff/callback and <origin>/signed-out - so it must equal the
# frontendOrigin the client was registered for; and the CSRF guard compares Origin to it (FR-BFF-6).
# https everywhere except local development, where it is the Vite dev server (see BFF_DEV_INSECURE_COOKIES).
BFF_PUBLIC_ORIGIN=https://frontend.example.test

# Local development only: true names the cookies bff-handshake / bff-session without the __Host- prefix and
# without Secure, which plain http cannot carry. Accepted only with an http://localhost (or 127.0.0.1, [::1])
# BFF_PUBLIC_ORIGIN, and never when NODE_ENV=production; a plain-http origin requires it. Default: false.
# BFF_DEV_INSECURE_COOKIES=false

# REQUIRED. The confidential OAuth client (FR-BFF-2), registered per environment by
# DEPLOYMENT.md. The id is the environment's clientId in
# ../config/oauth-clients.json (a workstation's own id for local).
OAUTH_CLIENT_ID=synthetic-client-id

# REQUIRED. The client secret: server-side environment ONLY - the deployed service's secret variable (a Railway
# variable on the staging service), an untracked env file on a workstation. Never in git, never VITE_*, never
# logged. Printable characters, no whitespace. The value below is a placeholder, not a secret.
OAUTH_CLIENT_SECRET=replace-with-the-registered-secret

# The FHIR read proxy (API-44). FHIR is slow - 4-8 s per search under fan-out (BUG-28) - so: one budget per read,
# queue wait included, in ms (1-120000; default 30000); reads in flight to OpenEMR at once (1-256; default 4); and
# of those, at most this many for one session (1-256, at most BFF_FHIR_MAX_CONCURRENT; default 3).
BFF_FHIR_TIMEOUT_MS=30000
BFF_FHIR_MAX_CONCURRENT=4
BFF_FHIR_MAX_CONCURRENT_PER_SESSION=3

# Budget for each call to OpenEMR's discovery, JWKS and token endpoints (sign-in and refresh) and the display-name
# look-up, in ms (1-60000). Default: 10000.
BFF_OAUTH_TIMEOUT_MS=10000

# Inactivity timeout (FR-AUTH-4), in seconds (60-3600): a session ends this long after its last authenticated
# request, whatever its refresh token allows. Reading /bff/session does not count as activity. Must not exceed
# BFF_MAX_SESSION_SECONDS. Default: 900 (15 minutes).
BFF_IDLE_TIMEOUT_SECONDS=900

# Maximum session length (PRD Q-2: one clinic day), in seconds from sign-in (300-86400): the session then ends
# however active it is and however valid its refresh token. Default: 36000 (10 hours).
BFF_MAX_SESSION_SECONDS=36000
