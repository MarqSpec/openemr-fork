{
  "name": "openemr-frontend",
  "private": true,
  "version": "0.1.0",
  "description": "React + TypeScript PWA reimplementing the OpenEMR patient dashboard (REQUIREMENTS.md)",
  "license": "GPL-3.0",
  "type": "module",
  "prettier": "gts/.prettierrc.json",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p scripts/tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "icons": "node scripts/icons/generate_icons.ts",
    "deps:audit": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/deps/check.ts audit . bff",
    "deps:licences": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/deps/check.ts licences . bff",
    "check:no-cdn": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/deps/check.ts no-cdn dist",
    "oauth:register": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/oauth_client/register.ts"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/material": "^9.4.0",
    "@tanstack/react-query": "^5.103.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-error-boundary": "^6.1.6",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@usebruno/cli": "4.2.0",
    "@eslint/js": "^9.0.0",
    "@playwright/test": "1.63.0",
    "@resvg/resvg-js": "^2.6.2",
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.0.0",
    "@types/fhir": "^0.0.44",
    "@types/jsdom": "~27.0.0",
    "@types/node": "^22.20.4",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.1",
    "axe-core": "~4.13.0",
    "eslint": "^9.0.0",
    "eslint-plugin-jsx-a11y": "^6.10.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "globals": "^16.0.0",
    "gts": "^7.0.0",
    "jsdom": "^27.0.0",
    "msw": "^2.15.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.0.0",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^8.3.1",
    "vitest": "^5.0.1"
  }
}
